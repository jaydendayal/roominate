# Browser-visible backend origin (never put the API key in a NEXT_PUBLIC variable)
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_DETAIL=low

# $10 total credit policy: $9 callable, $1 held in reserve.
OPENAI_AGGREGATE_SPEND_GUARD_USD=9.00
OPENAI_MAX_CALLS_PER_PROJECT=6
OPENAI_MAX_ESTIMATED_CALL_USD=0.08

# Defaults below match gpt-4.1-mini standard rates when this project was built.
# Update both values if OPENAI_MODEL changes.
OPENAI_INPUT_COST_PER_1M=0.40
OPENAI_OUTPUT_COST_PER_1M=1.60

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROOMINATE_AI_DB=backend/data/ai_cache.sqlite

# Optional Amazon Associates Creators API product discovery.
# Requires a fully accepted Associates account and Creators API access.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_ASSOCIATE_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
